<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net481;net10.0-windows</TargetFrameworks>
    <OutputType>Library</OutputType>
    <RootNamespace>TlsMailSender</RootNamespace>
    <AssemblyName>TlsMailSender</AssemblyName>
    <ProjectGuid>{4EB9310A-F7B9-49B5-9BFB-235243010AD5}</ProjectGuid>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>

    <!--
      Release + net481 빌드에서만 NuGet 의존 DLL을 출력 폴더에 복사합니다.
      Debug 빌드와 net10.0-windows 게시에서는 복사하지 않습니다.
      ILRepack이 $(OutputPath)에서 입력 파일을 읽으려면 이 플래그가 필요합니다.
    -->
    <CopyLocalLockFileAssemblies Condition="'$(Configuration)' == 'Release' AND '$(TargetFramework)' == 'net481'">true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- Native AOT / C-Export: net10.0-windows 게시 시에만 네이티브 공유 라이브러리를 만듭니다. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-windows'">
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifiers>win-x64;win-x86</RuntimeIdentifiers>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <IsAotCompatible>true</IsAotCompatible>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <None Include="AllowedCerts.txt" />
  </ItemGroup>

  <!--
    System.Memory : Span/ReadOnlySpan/AsSpan — net481 BCL 미포함
    System.Buffers : ArrayPool — 첨부파일 버퍼 풀링으로 LOH·단편화 완화
    net10.0-windows 에는 인박스이므로 net481 에서만 참조합니다.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net481'">
    <PackageReference Include="System.Memory" />
    <PackageReference Include="System.Buffers" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" />

    <!--
      ILRepack : IncludeAssets=none → 빌드 참조(compile/runtime)에 추가하지 않음
                 패키지 자체는 복원되어 $(PkgILRepack) 경로가 설정됩니다.
                 PrivateAssets=all  → 이 프로젝트를 참조하는 상위 프로젝트에 전파하지 않음
    -->
    <PackageReference Include="ILRepack">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>none</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!--
    [MergeAssemblies] net481 Release 빌드 완료 후 NuGet 의존 어셈블리를 단일 DLL로 병합합니다.

    목적 : PowerBuilder COM 배포 시 추가 DLL 없이 TlsMailSender.dll 하나만 배포합니다.
    방법 : ILRepack /internalize — 병합된 타입을 internal로 제한해 COM 노출 표면을 유지합니다.
    출력 : release-files\net481\TlsMailSender.dll  (빌드 출력과 별도)

    병합 대상 (순서 중요 — 기본 어셈블리가 첫 번째):
      1. TlsMailSender.dll         ← 기본(primary) 어셈블리
      2. System.Memory.dll
      3. System.Buffers.dll
      4. System.Runtime.CompilerServices.Unsafe.dll
  -->
  <Target Name="MergeAssemblies" AfterTargets="Build" Condition="'$(Configuration)' == 'Release' AND '$(TargetFramework)' == 'net481'">

    <PropertyGroup>
      <_ILRepackExe>$(PkgILRepack)\tools\ILRepack.exe</_ILRepackExe>
      <_MergedDir>$(MSBuildThisFileDirectory)release-files\$(TargetFramework)\</_MergedDir>
      <_MergedOut>$(_MergedDir)$(AssemblyName).dll</_MergedOut>
    </PropertyGroup>

    <Error Text="ILRepack.exe not found: $(_ILRepackExe). Run 'dotnet restore' first."
           Condition="!Exists('$(_ILRepackExe)')" />

    <MakeDir Directories="$(_MergedDir)" />

    <Message Text="ILRepack: $(AssemblyName) + NuGet deps → $(_MergedOut)" Importance="high" />

    <Exec
      Command="&quot;$(_ILRepackExe)&quot; /internalize /copyattrs /out:&quot;$(_MergedOut)&quot; &quot;$(OutputPath)$(AssemblyName).dll&quot; &quot;$(OutputPath)System.Memory.dll&quot; &quot;$(OutputPath)System.Buffers.dll&quot; &quot;$(OutputPath)System.Runtime.CompilerServices.Unsafe.dll&quot;"
      IgnoreExitCode="false" />

    <Message Text="ILRepack: 완료 → $(_MergedOut)" Importance="high" />
  </Target>

</Project>
